# Copia este archivo como .env.local (nunca se sube al repositorio).
# Todas las variables son públicas (NEXT_PUBLIC_): no pongas secretos aquí.

# Dominio final del sitio, sin barra al final. Se usa en sitemap, canonical y datos estructurados.
NEXT_PUBLIC_SITE_URL=https://www.inmobiliariagarciayasociados.com

# ID del Meta Pixel de García & Asociados. Vacío = se usa meta.pixelId de contenido/sitio.json (1722067732205993).
NEXT_PUBLIC_META_PIXEL_ID=

# ID del formulario de GoHighLevel para la página de contacto (widget link.marketinghotelero.com).
# Vacío = el formulario compone un mensaje de WhatsApp (sin CRM).
NEXT_PUBLIC_GHL_FORM_ID=

# ID del calendario de GoHighLevel para "Agendar visita". Vacío = se ofrece WhatsApp.
NEXT_PUBLIC_GHL_CALENDAR_ID=

# ID del widget de chat en directo de GoHighLevel (Sitios → Widget de chat → Obtener código).
# Si se deja vacío se usa el de contenido/sitio.json (ghl.chatWidgetId).
NEXT_PUBLIC_GHL_CHAT_WIDGET_ID=
